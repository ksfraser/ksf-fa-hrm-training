<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /modules/ksf_FA_HRM_Training/

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>

ErrorDocument 404 /modules/ksf_FA_HRM_Training/index.php
